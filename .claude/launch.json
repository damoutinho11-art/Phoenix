{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jarvis-pwa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "cwd": "pwa",
      "autoPort": false
    },
    {
      "name": "jarvis-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "run_server.py"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "jarvis-pwa-railway",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=https://phoenix-production-1fb2.up.railway.app&& npx vite --config vite.http.config.js --port 5174 --strictPort"
      ],
      "port": 5174,
      "cwd": "pwa",
      "autoPort": false
    }
  ]
}